# Local use only: copy to .env for docker compose. Every value here is public.
APP_ENV=local
LOG_LEVEL=info
HTTP_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DB_MAX_CONNS=10
ACCESS_TOKEN_TTL=1h

POSTGRES_PASSWORD=local-postgres-password
MIGRATOR_PASSWORD=local-migrator-password
APP_DB_PASSWORD=local-app-password

# Public development key, for local use only; the app refuses it when APP_ENV=prod.
TOKEN_SIGNING_
